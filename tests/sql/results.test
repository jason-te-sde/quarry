{"columns":[{"name":"l_returnflag","type":"VARCHAR"},{"name":"n","type":"BIGINT"},{"name":"q","type":"DECIMAL(38,2)"}],"rows":[["A",14876,"380456.00"],["N",30397,"774222.00"],["R",14902,"381449.00"]]}

query
SELECT l_returnflag, l_linestatus, COUNT(*) AS n, AVG(l_linenumber) AS d, MAX(l_tax) AS t
FROM lineitem GROUP BY l_returnflag, l_linestatus ORDER BY l_returnflag, l_linestatus
----
{"columns":[{"name":"l_returnflag","type":"VARCHAR"},{"name":"l_linestatus","type":"VARCHAR"},{"name":"n","type":"BIGINT"},{"name":"d","type":"DOUBLE"},{"name":"t","type":"DECIMAL(15,2)"}],"rows":[["A","F",14876,3.009680021511159,"0.08"],["N","F",348,3.0344827586206895,"0.08"],["N","O",30049,2.9997004892009715,"0.08"],["R","F",14902,3.0073815595222118,"0.08"]]}

