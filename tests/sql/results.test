query
SELECT grp, COUNT(*) AS n, COUNT(qty) AS nq, SUM(price) AS sp, MIN(qty) AS mn, MAX(qty) AS mx, AVG(price) AS ap
FROM mixed GROUP BY grp ORDER BY grp
----
{"columns":[{"name":"grp","type":"VARCHAR"},{"name":"n","type":"BIGINT"},{"name":"nq","type":"BIGINT"},{"name":"sp","type":"DECIMAL(38,2)"},{"name":"mn","type":"INTEGER"},{"name":"mx","type":"INTEGER"},{"name":"ap","type":"DOUBLE"}],"rows":[["a",7,5,"51.55",2,9,8.5916666666666668],["b",6,5,"46.25",3,8,11.5625],["c",4,4,"223.44",1,7,111.72],[null,3,2,"0.15",1,2,0.049999999999999996]]}

