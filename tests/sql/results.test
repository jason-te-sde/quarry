# ---- aggregates ----

query
SELECT COUNT(*) AS c, COUNT(l_comment) AS cc, MIN(l_shipdate) AS mn, MAX(l_shipdate) AS mx FROM lineitem
----
{"columns":[{"name":"c","type":"BIGINT"},{"name":"cc","type":"BIGINT"},{"name":"mn","type":"DATE"},{"name":"mx","type":"DATE"}],"rows":[[60175,60175,"1992-01-04","1998-11-29"]]}

query
SELECT SUM(l_quantity) AS s, AVG(l_quantity) AS a, MIN(l_extendedprice) AS mn, MAX(l_extendedprice) AS mx
FROM lineitem
----
{"columns":[{"name":"s","type":"DECIMAL(38,2)"},{"name":"a","type":"DOUBLE"},{"name":"mn","type":"DECIMAL(15,2)"},{"name":"mx","type":"DECIMAL(15,2)"}],"rows":[["1536127.00",25.527660988782717,"904.00","94949.50"]]}

query
