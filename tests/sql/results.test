# Result tests: every query below runs on the engine, and its result is compared with DuckDB's. The
# line after `----` is generated: run `uv run scripts/gen_goldens.py` after changing a query.
#
# A query with ORDER BY is compared row by row; a query without one as a multiset of rows. Select
# items that are not plain columns carry an alias, because DuckDB names them differently. Queries
# with an ORDER BY order their rows totally, so that the order does not depend on how ties break.
# AVG of a DECIMAL column over many rows is not used: DuckDB's own answer differs in the last digit
# from one query to the next (it sums in floating point), so there is no single answer to match.

# ---- scans, projections, filters ----

query
SELECT r_regionkey, r_name FROM region ORDER BY r_regionkey
----
{"columns":[{"name":"r_regionkey","type":"INTEGER"},{"name":"r_name","type":"VARCHAR"}],"rows":[[0,"AFRICA"],[1,"AMERICA"],[2,"ASIA"],[3,"EUROPE"],[4,"MIDDLE EAST"]]}

query
SELECT n_name AS name, n_nationkey + 1 AS k FROM nation WHERE n_regionkey = 2 ORDER BY n_nationkey
----
{"columns":[{"name":"name","type":"VARCHAR"},{"name":"k","type":"INTEGER"}],"rows":[["INDIA",9],["INDONESIA",10],["JAPAN",13],["CHINA",19],["VIETNAM",22]]}

query
